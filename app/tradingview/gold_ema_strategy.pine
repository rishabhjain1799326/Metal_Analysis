//@version=6
strategy("Gold EMA Crossover Strategy - Backtest", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

string signalGroup = "Signal rules"
string testGroup = "Backtest"

fastLength = input.int(20, "Fast EMA", group=signalGroup, minval=1)
slowLength = input.int(50, "Slow EMA", group=signalGroup, minval=2)
tradeMode = input.string("Long and short", "Trade direction", options=["Long and short", "Long only"], group=signalGroup)
requireRsiConfirmation = input.bool(false, "Require RSI confirmation", group=signalGroup)
rsiLength = input.int(14, "RSI length", group=signalGroup, minval=1)
rsiMidpoint = input.float(50.0, "RSI confirmation level", group=signalGroup, minval=1, maxval=99, step=0.5)
startDate = input.time(timestamp("01 Jan 2010 00:00 +0000"), "Backtest start", group=testGroup)
endDate = input.time(timestamp("31 Dec 2099 23:59 +0000"), "Backtest end", group=testGroup)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
ready = not na(slowEma) and not na(rsiValue)
inDateRange = time >= startDate and time <= endDate

buySignal = ready and ta.crossover(fastEma, slowEma) and (not requireRsiConfirmation or rsiValue > rsiMidpoint)
sellSignal = ready and ta.crossunder(fastEma, slowEma) and (not requireRsiConfirmation or rsiValue < rsiMidpoint)

if inDateRange and buySignal
    strategy.entry("Long", strategy.long)

if inDateRange and sellSignal
    if tradeMode == "Long and short"
        strategy.entry("Short", strategy.short)
    else
        strategy.close("Long", comment="Bearish crossover")

if not inDateRange and strategy.position_size != 0
    strategy.close_all(comment="Outside backtest range")

plot(fastEma, title="Fast EMA", color=color.orange, linewidth=2)
plot(slowEma, title="Slow EMA", color=color.blue, linewidth=2)
plotshape(inDateRange and buySignal, title="Buy signal", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white, size=size.small)
plotshape(inDateRange and sellSignal, title="Sell signal", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.small)

alertcondition(buySignal, title="Gold bullish EMA crossover", message="Gold fast EMA crossed above the slow EMA.")
alertcondition(sellSignal, title="Gold bearish EMA crossover", message="Gold fast EMA crossed below the slow EMA.")
